{
  "expo": {
    "name": "EduSync",
    "slug": "microlearning-mobile",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "edusync",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3f928282-25db-403a-a11f-b4a0a1ec7601"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.edusync.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070B17"
      },
      "package": "com.edusync.mobile",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#070B17"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-video",
        {
          "supportsPictureInPicture": true,
          "supportsBackgroundAudio": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#070B17"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần quyền truy cập Thư viện ảnh để tải lên video bài giảng."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3f928282-25db-403a-a11f-b4a0a1ec7601"
      }
    },
    "owner": "devminhtan"
  }
}