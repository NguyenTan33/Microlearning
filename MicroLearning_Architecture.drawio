        <!-- Cloud 1: Azure SQL -->
        <mxCell id="cloud_sql" value="&lt;b&gt;🗄️ Azure SQL Database&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0078D4&quot;&gt;(Serverless Tier)&lt;/font&gt;&lt;hr style=&quot;border-top: 1px dashed #BBDEFB;&quot;&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 10.5px; padding: 2px;&quot;&gt;• 2 vCores Auto-Scale / Auto-pause&lt;br&gt;• 3NF Normalized Relational Schema&lt;br&gt;• B-Tree Composite Indexes&lt;br&gt;• Change Data Capture (CDC)&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E3F2FD;strokeColor=#0288D1;strokeWidth=1.5;fontSize=11;fontColor=#01579B;align=center;shadow=1;" vertex="1" parent="layer_cloud">
