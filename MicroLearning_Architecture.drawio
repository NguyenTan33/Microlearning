          <mxGeometry x="380" y="40" width="600" height="290" as="geometry" />
        </mxCell>

        <!-- Web App Box -->
        <mxCell id="client_web" value="&lt;b&gt;🌐 Web App&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1565C0&quot;&gt;(React 18 + TypeScript + Tailwind)&lt;/font&gt;&lt;hr style=&quot;border-top: 1px dashed #BBDEFB;&quot;&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; padding: 4px;&quot;&gt;• Study Dashboard &amp;amp; Studio&lt;br&gt;• Video Player &amp;amp; Bookmarks&lt;br&gt;• RAG AI Notebook Hub&lt;br&gt;• Quiz Practice &amp;amp; Flashcard&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontSize=12;fontColor=#0D47A1;align=center;verticalAlign=top;spacingTop=6;shadow=1;" vertex="1" parent="layer_client">
          <mxGeometry x="40" y="55" width="230" height="205" as="geometry" />
        </mxCell>

        <!-- Mobile App Box -->
